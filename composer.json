{
    "name": "brendan/boardkit",
    "description": "Kanban board and editorial calendar for WordPress content. Companion to ColumnKit.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "BoardKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BoardKit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {},
        "platform": {
            "php": "8.1.0"
        }
    }
}
